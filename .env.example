PORT=3000

# Local dev: discrete fields (used by docker-compose.yml).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ollytiket
DB_PASSWORD=ollytiket
DB_NAME=ollytiket

# Hosted (e.g. Render): set DATABASE_URL instead — it takes priority over
# the discrete DB_* fields above. Needs DB_SSL=true (default) against most
# managed Postgres providers, since they use self-signed certs.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DB_SSL=true

# Set true only while there are no migrations yet — auto-creates tables
# from entities. Switch to migrations before this ever holds real data.
DB_SYNCHRONIZE=true

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d
