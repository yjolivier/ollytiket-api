meta {
  name: List Tickets
  type: http
  seq: 1
}

get {
  url: {{OLLYTIKET_URL}}/tickets?eventId={{OLLYTIKET_EVENT_ID}}
  body: none
  auth: bearer
}

params:query {
  eventId: {{OLLYTIKET_EVENT_ID}}
}

auth:bearer {
  token: {{LOGIN_TOKEN}}
}

vars:pre-request {
  OLLYTIKET_EVENT_ID: 2d1a26d8-ae52-4327-840d-cbed6f9f3e08
}

docs {
  Lists tickets belonging to the authenticated manager's events, newest
  first. `eventId` is optional — remove/disable the query param to list
  tickets across all of the manager's events.
}
