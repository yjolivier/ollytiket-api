meta {
  name: Create Event
  type: http
  seq: 2
}

post {
  url: {{OLLYTIKET_URL}}/events
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Didi B — Juste Comme Ça Tour",
    "date": "2026-08-15",
    "time": "20:00",
    "city": "Abidjan",
    "country": "Côte d'Ivoire",
    "venue": "Palais de la Culture de Treichville",
    "venueHint": "Entrée principale côté lagune",
    "capacity": 2000,
    "margin": 100,
    "alloc": {
      "vvvip": 200,
      "vvip": 300,
      "vip": 400,
      "standard": 600
    },
    "prices": {
      "vvvip": 75000,
      "vvip": 50000,
      "vip": 30000,
      "standard": 15000,
      "grand": 10000
    }
  }
}

script:post-response {
  const response = res.getBody();
  if (response.id) {
    bru.setGlobalEnvVar("OLLYTIKET_EVENT_ID", response.id);
  }
}

docs {
  Creates an event owned by the authenticated manager.

  `alloc` covers vvvip/vvip/vip/standard only — `grand` capacity is always
  the remainder (`capacity - sum(alloc)`). Fails with 400 if the allocated
  sum exceeds `capacity`.

  Saves the created event's `id` to `OLLYTIKET_EVENT_ID` for use by other
  requests in this collection (Update Event, Generate Ticket, ...).
}
